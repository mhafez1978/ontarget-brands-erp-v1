generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @map("userId")
  name          String?   @db.VarChar(255)
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  birthDate     DateTime?
  password      String    @db.VarChar(255)
  addressLine1  String?   @db.VarChar(255)
  addressLine2  String?   @db.VarChar(255)
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  zipCode       String?   @db.VarChar(20)
  country       String?   @db.VarChar(100)

  // Multi-company ownership
  ownedCompanies Company[] @relation("CompanyOwner")

  // All companies the user is linked to
  companies Company[] @relation("CompanyUsers")

  // Active company context
  companyId String?
  company   Company? @relation("UserActiveCompany", fields: [companyId], references: [id], onDelete: SetNull) // Clear active company if company is deleted

  isActive        Boolean           @default(true)
  role            Role              @default(ERP_CUSTOMER)
  lastLogin       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime? // Added for soft deletes
  ProjectCustomer ProjectCustomer[]
  ProjectStaff    ProjectStaff[]
  Project         Project[]

  @@map("users")
}

model Company {
  id                 String             @id @default(uuid()) @map("companyId")
  name               String             @unique @db.VarChar(255)
  slogan             String?            @db.VarChar(255)
  category           CompanyCategory?
  type               BusinessType?
  logo               String?            @db.VarChar(255)
  domain             String?            @unique @db.VarChar(255)
  CompanySubdomain   CompanySubdomain[]
  isCustomDomain     Boolean?           @default(false)
  phone              String?            @db.VarChar(20)
  supportEmail       String?            @unique @db.VarChar(255)
  salesEmail         String?            @unique @db.VarChar(255)
  addressLine1       String?            @db.VarChar(255)
  addressLine2       String?            @db.VarChar(255)
  city               String?            @db.VarChar(100)
  state              String?            @db.VarChar(100)
  zipCode            String?            @db.VarChar(20)
  country            String?            @db.VarChar(100)
  emailProvider      EmailProviders?
  isActive           Boolean            @default(true)
  gmailConnected     Boolean            @default(false)
  office365Connected Boolean            @default(false)

  // Owner relation
  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: NoAction) // Prevent owner deletion to maintain company ownership

  // Active users (reverse relation of `User.company`)
  activeUsers User[] @relation("UserActiveCompany")

  // All users linked to this company
  users User[] @relation("CompanyUsers")

  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: NoAction) // Prevent plan deletion if companies exist

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime? // Added for soft deletes
  Project                Project[]
  CompanyLanding         CompanyLanding[]
  Product                Product[]
  Supplier               Supplier[]
  CompanyProductCategory CompanyProductCategory[]
  Service                Service[]

  @@map("companies")
}

model CompanySubdomain {
  id        String  @id @default(uuid())
  subdomain String  @unique
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id             String       @id @default(uuid()) @map("planId")
  key            String       @unique @db.VarChar(50)
  name           String       @unique @db.VarChar(100)
  description    String?      @db.VarChar(500)
  pricePerMonth  Decimal      @default(0.0)
  billingCycle   BillingCycle
  maxUsers       Int          @default(1)
  maxAdmins      Int          @default(1)
  maxManagers    Int          @default(0)
  maxCustomers   Int          @default(10)
  storageLimitMB Int          @default(100)
  maxProjects    Int          @default(3)
  features       Feature[]    @relation("PlanFeatures")
  companies      Company[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@map("subscription_plans")
}

model Feature {
  id        String             @id @default(uuid()) @map("featureId")
  key       String             @unique @db.VarChar(100)
  label     String             @db.VarChar(100)
  plans     SubscriptionPlan[] @relation("PlanFeatures")
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  @@map("features")
}

model CompanyLanding {
  id                             String    @id @default(uuid())
  heroTitle                      String?   @db.VarChar(100)
  heroDescription                String?   @db.VarChar(100)
  c2a1Text                       String?   @db.VarChar(100)
  c2a1Link                       String?   @db.VarChar(100)
  c2a2Text                       String?   @db.VarChar(100)
  c2a2Link                       String?   @db.VarChar(100)
  pinned1Title                   String?   @db.VarChar(100)
  pinned2Title                   String?   @db.VarChar(100)
  pinned3Title                   String?   @db.VarChar(100)
  pinned1Description             String?   @db.VarChar(100)
  pinned2Description             String?   @db.VarChar(100)
  pinned3Description             String?   @db.VarChar(100)
  testimonialsSectionTitle       String?   @db.VarChar(100)
  testimonialsSectionDescription String?   @db.VarChar(100)
  testimonial1Author             String?   @db.VarChar(100)
  testimonial1Text               String?   @db.VarChar(100)
  testimonial2Author             String?   @db.VarChar(100)
  testimonial2Text               String?   @db.VarChar(100)
  contactSectionTitle            String?   @db.VarChar(100)
  contactSectionDescription      String?   @db.VarChar(100)
  companyId                      String
  company                        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  deletedAt                      DateTime?
}

model Project {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(255)
  description String?          @db.Text
  status      ProjectStatus    @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  budget      Decimal?
  progress    Int?
  managerId   String?
  manager     User?            @relation(fields: [managerId], references: [id], onDelete: SetNull)
  customerid  String?
  customer    ProjectCustomer? @relation("ProjectToCustomer")
  staff       ProjectStaff[]
  isActive    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime? // Added for soft deletes

  @@map("projects")
}

model ProjectStaff {
  id         String    @id @default(uuid()) @map("projectStaffId")
  projectId  String
  userId     String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  dueDate    DateTime?

  @@unique([projectId, userId])
  @@map("project_staff")
}

model ProjectCustomer {
  id        String   @id @default(uuid()) @map("projectCustomerId")
  projectId String   @unique
  userId    String
  project   Project  @relation("ProjectToCustomer", fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?  @db.VarChar(100)
  notes     String?  @db.Text
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_customers")
}

model Product {
  id             String                   @id @default(uuid())
  name           String
  description    String?
  sku            String?
  upc            String?
  unit           ProductUnit?
  quantity       Int?
  cost           Float?
  price          Float?
  brand          String?
  status         ProductStatus?
  supplierId     String?
  supplier       Supplier?                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  deliveryMethod DeliveryMethod
  category       CompanyProductCategory[]
  companyId      String
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?
}

model Supplier {
  id           String    @id @default(uuid())
  name         String
  tagline      String?
  website      String?
  salesEmail   String?
  supportEmail String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zipCode      String?
  country      String?
  product      Product[]
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model CompanyProductCategory {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productCategory ProductCategory
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
}

model Service {
  id             String          @id @default(uuid())
  tags           ServiceTag[]    @relation("ServiceTags")
  companyId      String
  description    String?
  deliveryMethod DeliveryMethod?
  duration       Int?
  price          Decimal?        @db.Decimal(10, 2)
  currency       Currency?
  isActive       Boolean         @default(true)
  categories     ServiceCategory
  tag            ServiceTag[]
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ServiceTag {
  id        String   @id @default(uuid())
  value     String   @db.VarChar(100)
  service   Service  @relation("ServiceTags", fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Service Service[]
}

