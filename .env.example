# Copy to .env.local and fill in real values. Never commit .env.local.

# MySQL connection string used by Prisma (see prisma.config.ts).
DATABASE_URL="mysql://user:password@host:3306/database"

# next-auth v5 secret. NOTE: v5 reads AUTH_SECRET — the v4 names
# NEXTAUTH_SECRET / NEXTAUTH_URL are NOT read by this app.
AUTH_SECRET=""

# Required in production when running behind a proxy or on subdomains,
# so next-auth trusts the forwarded host.
AUTH_TRUST_HOST="true"

# Absolute origin of the deployment. Used to build the Google OAuth redirect
# URI, which must match the value registered in the Google Cloud console.
NEXT_PUBLIC_BASE_URL="https://example.com"

# Google OAuth client used for the Gmail connection flow.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
